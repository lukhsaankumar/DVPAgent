# dotenv (.env, .env.sandbox, .env.production, .env.local, etc. -- but keep the
# committed *.example templates, which contain no real credentials)
.env
.env.*
!.env.example
!.env.sandbox.example
!.env.production.example

# Salesforce debug extracts (SF_SAVE_DEBUG_EXTRACTS=true) -- may contain
# sensitive advisor/account data, never commit these
.salesforce_debug/

# Real production/sandbox source data files (spreadsheets, CSV exports) --
# never commit real advisor/client data.
refs/

# VS Code
.vscode/

# IDEs
.idea/

# macOS
.DS_Store

# Windows
Thumbs.db

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer artifacts
*.msi
*.exe

# static build
staticfiles/

# node
node_modules/

# logs
*.log

# local sqlite DBs -- data/dvp_meeting_prep.sqlite3 (and its WAL/SHM sidecar
# files) is created at runtime by scripts/init_sqlite.py / ensure_schema_ready().
# Never commit real application data; data/.gitkeep keeps the directory itself
# tracked so a fresh checkout has somewhere for SQLITE_DB_PATH to resolve to.
*.db
data/*.db
data/*.sqlite
data/*.sqlite3
data/*.db-wal
data/*.db-shm
data/*.sqlite-wal
data/*.sqlite-shm
data/*.sqlite3-wal
data/*.sqlite3-shm
!data/.gitkeep

# compiled c extensions
*.pyd


RelatedMaterials/

output/