# Copy to .env.sandbox and fill in real values (never commit .env.sandbox).
# Loaded automatically when APP_ENV=sandbox (or ENV_FILE=.env.sandbox is set
# explicitly). See docs/SALESFORCE_SETUP.md for the full walkthrough.

# --- Database (local SQLite, unchanged by data source) ---------------------
DATABASE_BACKEND=sqlite
SQLITE_DB_PATH=data/dvp_meeting_prep.sqlite3
SQLITE_BUSY_TIMEOUT_MS=10000
SQLITE_JOURNAL_MODE=WAL
SQLITE_FOREIGN_KEYS=true
SQLITE_SYNCHRONOUS=NORMAL
SQLITE_DEBUG=false

# --- Gemini Enterprise (Google Application Default Credentials) ------------
# Run `gcloud auth application-default login` first -- no API key is used.
LLM_PROVIDER=gemini_enterprise
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_MODEL=gemini-2.0-flash-001
GOOGLE_GENAI_API_VERSION=v1
GOOGLE_GENAI_TEMPERATURE=0.2
GOOGLE_GENAI_MAX_OUTPUT_TOKENS=8192
GOOGLE_GENAI_REQUEST_TIMEOUT_SECONDS=120
GOOGLE_GENAI_MAX_RETRIES=3
STORE_LLM_AUDIT_CONTENT=true

# --- Data source -------------------------------------------------------------
DATA_SOURCE=salesforce
# legacy | auto -- which table (salesforce_data vs salesforce_data_auto) the
# advisor dropdown/meeting-prep generation read from. See .env.example for
# the full explanation.
ADVISOR_SOURCE_MODE=legacy
APP_ENV=sandbox

LOG_LEVEL=DEBUG
SF_DEBUG=true
SF_DEBUG_SAMPLE_SIZE=3
# Debug extracts land in the gitignored .salesforce_debug/ directory and can
# contain real advisor/account data -- leave off unless you're actively
# debugging a mapping problem.
SF_SAVE_DEBUG_EXTRACTS=false
# false = mismatched expected counts log a [VALIDATION] warning and continue.
# true  = mismatched counts raise and stop the run.
SF_STRICT_EXPECTED_COUNTS=false

# --- Authentication -----------------------------------------------------------
# password = username + password + security token (recommended for sandboxes
#            and unattended/CLI use -- access tokens expire quickly).
# access_token = an existing session_id/instance_url pair (e.g. from an OAuth
#            flow elsewhere); nothing here refreshes it when it expires.
SF_AUTH_MODE=password
SF_USERNAME=your-sandbox-username
SF_PASSWORD=replace-me
SF_SECURITY_TOKEN=replace-me

# Only used when SF_AUTH_MODE=access_token:
SF_ACCESS_TOKEN=
SF_INSTANCE_URL=

# --- Object/field API names ---------------------------------------------------
# Confirmed against the igdigitalplatform--ahackathon sandbox via:
#   python scripts/salesforce_extract.py --discover-salesforce
# If you're setting up against a *different* org/sandbox, re-run discovery --
# these are not guaranteed to match every org.
SF_ADVISOR_OBJECT=Account
SF_ADVISOR_NUMBER_FIELD=Servicing_Advisor_Number__c
# Leave blank to use the Advisor record's own Id as the Task/Opportunity
# relationship scope. Set this if Advisors roll up to a separate Practice
# object/record that Tasks and Opportunities actually relate to.
SF_PRACTICE_LOOKUP_FIELD=

SF_TASK_LINK_FIELD=WhatId
SF_OPPORTUNITY_LINK_FIELD=AccountId

# Advisor-level legacy columns (district_vp_wholesaling, pwm, book_size, etc.)
# and the one ambiguous Task column (interaction_type) don't have obvious
# standard-field equivalents -- override individual entries here as
# "legacy_column=Real_API_Name__c" without needing to restate the whole map.
# Only entries that differ from the built-in guess (config.py's
# DEFAULT_ADVISOR_FIELD_MAP) need to be listed -- pwm, book_size,
# new_business_ytd, area, start_date, and assigned already matched this
# sandbox's real field names and don't need an override.
# See docs/SALESFORCE_SETUP.md for the full default mapping.
SF_ADVISOR_FIELD_MAP=district_vp_wholesaling=Practice_District_VP_wholesaling__c,assets_under_management=Assets_under_Management_AUM__c,region_office_number=User_Region_Office_Number__c
SF_TASK_FIELD_MAP=

SF_ADVISOR_NUMBERS=17018,34318,34605,21114,20728
SF_TASK_SUBJECTS=Call,Virtual Meeting

# Leave blank until the exact business date/range is confirmed -- do not
# guess "past two years" vs "January of last year onward"; blank means no
# ActivityDate filter is applied at all.
SF_ACTIVITY_START_DATE=

SF_EXPECTED_ADVISOR_COUNT=5
SF_EXPECTED_TASK_COUNT=83
SF_EXPECTED_OPPORTUNITY_COUNT=4

# Additional fields to pull beyond the built-in preferred list, comma-separated.
SF_ADVISOR_EXTRA_FIELDS=
SF_TASK_EXTRA_FIELDS=
SF_OPPORTUNITY_EXTRA_FIELDS=

CSV_INPUT_PATH=
