# Copy to .env.production and fill in real values (never commit .env.production).
# Loaded automatically when APP_ENV=production (or ENV_FILE=.env.production
# is set explicitly). Same shape as .env.sandbox.example -- see that file's
# comments and docs/SALESFORCE_SETUP.md for what each variable does.
#
# Differences that matter for production:
#   - APP_ENV=production selects the "login" Salesforce auth domain instead
#     of "test".
#   - SF_STRICT_EXPECTED_COUNTS is worth setting to true once the expected
#     counts are known and stable, so a broken integration fails loudly
#     instead of silently producing partial data.
#   - Use a dedicated production SQLITE_DB_PATH (e.g. on a persistent volume
#     mounted at /app/data) -- do not reuse a sandbox/dev database file.
#   - Production must authenticate to Gemini Enterprise via a Google Cloud
#     runtime identity (e.g. a GKE/Cloud Run service account), not a
#     developer's local `gcloud auth application-default login` credentials.
#     Nothing in this file grants that -- it is configured at the Google
#     Cloud infrastructure layer, outside the app's environment variables.

DATABASE_BACKEND=sqlite
SQLITE_DB_PATH=data/dvp_meeting_prep.sqlite3
SQLITE_BUSY_TIMEOUT_MS=10000
SQLITE_JOURNAL_MODE=WAL
SQLITE_FOREIGN_KEYS=true
SQLITE_SYNCHRONOUS=NORMAL
SQLITE_DEBUG=false

LLM_PROVIDER=gemini_enterprise
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_MODEL=gemini-2.0-flash-001
GOOGLE_GENAI_API_VERSION=v1
GOOGLE_GENAI_TEMPERATURE=0.2
GOOGLE_GENAI_MAX_OUTPUT_TOKENS=8192
GOOGLE_GENAI_REQUEST_TIMEOUT_SECONDS=120
GOOGLE_GENAI_MAX_RETRIES=3
STORE_LLM_AUDIT_CONTENT=true

DATA_SOURCE=salesforce
APP_ENV=production

LOG_LEVEL=INFO
SF_DEBUG=false
SF_DEBUG_SAMPLE_SIZE=3
SF_SAVE_DEBUG_EXTRACTS=false
SF_STRICT_EXPECTED_COUNTS=false

SF_AUTH_MODE=password
SF_USERNAME=your-production-integration-username
SF_PASSWORD=replace-me
SF_SECURITY_TOKEN=replace-me

SF_ACCESS_TOKEN=
SF_INSTANCE_URL=

# SF_ADVISOR_NUMBER_FIELD and SF_ADVISOR_FIELD_MAP below are copied from the
# igdigitalplatform--ahackathon *sandbox*'s confirmed field names -- a
# sandbox's metadata isn't guaranteed to match production exactly. Re-run
# `python scripts/salesforce_extract.py --discover-salesforce` against the
# real production org before trusting these here.
SF_ADVISOR_OBJECT=Account
SF_ADVISOR_NUMBER_FIELD=Servicing_Advisor_Number__c
SF_PRACTICE_LOOKUP_FIELD=

SF_TASK_LINK_FIELD=WhatId
SF_OPPORTUNITY_LINK_FIELD=AccountId

SF_ADVISOR_FIELD_MAP=district_vp_wholesaling=Practice_District_VP_wholesaling__c,assets_under_management=Assets_under_Management_AUM__c,region_office_number=User_Region_Office_Number__c
SF_TASK_FIELD_MAP=

SF_ADVISOR_NUMBERS=17018,34318,34605,21114,20728
SF_TASK_SUBJECTS=Call,Virtual Meeting

SF_ACTIVITY_START_DATE=

SF_EXPECTED_ADVISOR_COUNT=5
SF_EXPECTED_TASK_COUNT=83
SF_EXPECTED_OPPORTUNITY_COUNT=4

SF_ADVISOR_EXTRA_FIELDS=
SF_TASK_EXTRA_FIELDS=
SF_OPPORTUNITY_EXTRA_FIELDS=

CSV_INPUT_PATH=
