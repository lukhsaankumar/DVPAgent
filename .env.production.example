# Copy to .env.production and fill in real values (never commit .env.production).
# Loaded automatically when APP_ENV=production (or ENV_FILE=.env.production
# is set explicitly). Same shape as .env.sandbox.example -- see that file's
# comments and docs/SALESFORCE_SETUP.md for what each variable does.
#
# Differences that matter for production:
#   - APP_ENV=production selects the "login" Salesforce auth domain instead
#     of "test", and should point at a separate production Supabase project.
#   - SF_STRICT_EXPECTED_COUNTS is worth setting to true once the expected
#     counts are known and stable, so a broken integration fails loudly
#     instead of silently producing partial data.
#   - Use a dedicated production Supabase project/keys -- do not reuse the
#     sandbox database.

SUPABASE_URL=https://your-production-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-public-key
SUPABASE_SECRET_KEY=your-service-role-key
SUPABASE_URI=postgresql://postgres:your-password@db.your-production-project-ref.supabase.co:5432/postgres
OPENAI_API_KEY=sk-your-key
OPENAI_MODEL=gpt-4.1-mini

DATA_SOURCE=salesforce
APP_ENV=production

LOG_LEVEL=INFO
SF_DEBUG=false
SF_DEBUG_SAMPLE_SIZE=3
SF_SAVE_DEBUG_EXTRACTS=false
SF_STRICT_EXPECTED_COUNTS=false

SF_AUTH_MODE=password
SF_USERNAME=your-production-integration-username
SF_PASSWORD=replace-me
SF_SECURITY_TOKEN=replace-me

SF_ACCESS_TOKEN=
SF_INSTANCE_URL=

SF_ADVISOR_OBJECT=Account
SF_ADVISOR_NUMBER_FIELD=Advisor_Number__c
SF_PRACTICE_LOOKUP_FIELD=

SF_TASK_LINK_FIELD=WhatId
SF_OPPORTUNITY_LINK_FIELD=AccountId

SF_ADVISOR_FIELD_MAP=
SF_TASK_FIELD_MAP=

SF_ADVISOR_NUMBERS=17018,34318,34605,21114,20728
SF_TASK_SUBJECTS=Call,Virtual Meeting

SF_ACTIVITY_START_DATE=

SF_EXPECTED_ADVISOR_COUNT=5
SF_EXPECTED_TASK_COUNT=83
SF_EXPECTED_OPPORTUNITY_COUNT=4

SF_ADVISOR_EXTRA_FIELDS=
SF_TASK_EXTRA_FIELDS=
SF_OPPORTUNITY_EXTRA_FIELDS=

CSV_INPUT_PATH=
