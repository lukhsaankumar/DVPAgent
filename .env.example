# Supabase project settings (Project Settings > API in the Supabase dashboard)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-public-key
SUPABASE_SECRET_KEY=your-service-role-key
# Project Settings > Database > Connection string (used only by scripts/run_schema.py)
SUPABASE_URI=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# OpenAI API settings
OPENAI_API_KEY=sk-your-key
OPENAI_MODEL=gpt-4.1-mini

# --- Data source selection -------------------------------------------------
# salesforce = pull advisor/task data live from Salesforce (default).
# csv        = local .xlsx fallback (see CSV_INPUT_PATH), for offline dev
#              or when Salesforce access isn't available.
DATA_SOURCE=salesforce

# sandbox | production | custom -- picks the Salesforce auth domain (test /
# login / a custom My Domain) and, together with ENV_FILE below, which
# environment-specific dotenv file gets loaded.
APP_ENV=sandbox

# Explicit dotenv file to load instead of deriving one from APP_ENV. Leave
# blank to use the APP_ENV convention (.env.sandbox / .env.production) or a
# plain .env. See .env.sandbox.example / .env.production.example.
ENV_FILE=

LOG_LEVEL=INFO

# See docs/SALESFORCE_SETUP.md for the full list of SF_* variables (auth,
# object/field names, expected counts, debug options). This file only
# documents the ones needed to get started; .env.sandbox.example has the
# complete set with inline explanations.
SF_AUTH_MODE=password
SF_USERNAME=
SF_PASSWORD=
SF_SECURITY_TOKEN=

# CSV/local fallback: path to the .xlsx export, used only when DATA_SOURCE=csv.
CSV_INPUT_PATH=
