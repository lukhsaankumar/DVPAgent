# --- Database (local SQLite, no server to run or credentials to manage) ----
DATABASE_BACKEND=sqlite
# Relative paths resolve against the project root (not the current working
# directory). See docs for scripts/init_sqlite.py / scripts/check_sqlite_tables.py.
SQLITE_DB_PATH=data/dvp_meeting_prep.sqlite3
SQLITE_BUSY_TIMEOUT_MS=10000
SQLITE_JOURNAL_MODE=WAL
SQLITE_FOREIGN_KEYS=true
SQLITE_SYNCHRONOUS=NORMAL
SQLITE_DEBUG=false

# --- Gemini Enterprise (Google Application Default Credentials) ------------
# Run `gcloud auth application-default login` first -- see README.md /
# docs/TESTING_GEMINI_SQLITE_MIGRATION.md. No API key is used or accepted.
LLM_PROVIDER=gemini_enterprise
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_MODEL=gemini-2.0-flash-001
GOOGLE_GENAI_API_VERSION=v1
GOOGLE_GENAI_TEMPERATURE=0.2
GOOGLE_GENAI_MAX_OUTPUT_TOKENS=8192
GOOGLE_GENAI_REQUEST_TIMEOUT_SECONDS=120
GOOGLE_GENAI_MAX_RETRIES=3
# true = store the full prompt/response text in meeting_prep_documents for
# audit purposes. Contains Salesforce notes -- keep false unless required.
STORE_LLM_AUDIT_CONTENT=true

# --- Data source selection -------------------------------------------------
# salesforce = pull advisor/task data live from Salesforce (default). Written
#              to the salesforce_data_auto table.
# csv        = local .xlsx fallback (see CSV_INPUT_PATH), for offline dev
#              or when Salesforce access isn't available. Written to the
#              salesforce_data table.
DATA_SOURCE=salesforce

# legacy | auto -- which of the two tables above the advisor search dropdown
# and meeting-prep generation read from ("legacy" = salesforce_data, "auto" =
# salesforce_data_auto). Independent of DATA_SOURCE above: you can ingest via
# one and browse the other, e.g. to compare a live pull against the manual
# spreadsheet. Advisors whose only data is in Tableau/the consultant
# scorecard show up either way. Can also be set per-run via
# `python scripts/run_server.py --advisor-source legacy|auto`.
ADVISOR_SOURCE_MODE=legacy

# sandbox | production | custom -- picks the Salesforce auth domain (test /
# login / a custom My Domain) and, together with ENV_FILE below, which
# environment-specific dotenv file gets loaded.
APP_ENV=sandbox

# Explicit dotenv file to load instead of deriving one from APP_ENV. Leave
# blank to use the APP_ENV convention (.env.sandbox / .env.production) or a
# plain .env. See .env.sandbox.example / .env.production.example.
ENV_FILE=

LOG_LEVEL=INFO

# See docs/SALESFORCE_SETUP.md for the full list of SF_* variables (auth,
# object/field names, expected counts, debug options). This file only
# documents the ones needed to get started; .env.sandbox.example has the
# complete set with inline explanations.
SF_AUTH_MODE=password
SF_USERNAME=
SF_PASSWORD=
SF_SECURITY_TOKEN=

# CSV/local fallback: path to the .xlsx export, used only when DATA_SOURCE=csv.
CSV_INPUT_PATH=
